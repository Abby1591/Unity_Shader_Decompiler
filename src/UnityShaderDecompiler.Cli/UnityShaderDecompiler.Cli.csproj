<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Kept as "Shader Decompiler" so existing scripts and docs that
             point at the built executable keep working. -->
        <AssemblyName>Shader Decompiler</AssemblyName>
        <RootNamespace>Parser</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnityShaderDecompiler.Core\UnityShaderDecompiler.Core.csproj" />
    </ItemGroup>

</Project>
